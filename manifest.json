{
  "manifest_version": 3,
  "name": "Cookie Shield",
  "version": "1.1.0",
  "description": "Varsayılan olarak pasif; açtığın sitede çerez onayını gerçek 'Reddet' tıklamasıyla kapatır, çerez duvarını aşar ve çerezleri engeller.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "cookies",
    "tabs",
    "alarms",
    "privacy",
    "browsingData"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Cookie Shield",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["src/page/page-agent.js"]
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "src/content/core.js",
        "src/content/adapters.js",
        "src/content/engine.js"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block-all-cookies",
        "enabled": false,
        "path": "rules/block-all-cookies.json"
      },
      {
        "id": "block-third-party-cookies",
        "enabled": false,
        "path": "rules/block-third-party-cookies.json"
      },
      {
        "id": "privacy-signals",
        "enabled": false,
        "path": "rules/privacy-signals.json"
      }
    ]
  }
}
